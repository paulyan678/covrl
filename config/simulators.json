{
  "schema_version": 1,
  "purpose": "Environment-variable reference matching the adapters; test options live in sim/manifests/regression.json",
  "project": {
    "top": "tb_top",
    "uvm_version": "1.2",
    "source_manifest": "sim/manifests/uvm.f",
    "rtl_smoke_manifest": "sim/manifests/rtl_smoke.f",
    "output_root": "outputs"
  },
  "simulators": {
    "vcs": {
      "compile_executable_env": "VLOGAN",
      "compile_executable_default": "vlogan",
      "elaborate_executable_env": "VCS",
      "elaborate_executable_default": "vcs",
      "coverage_merge_executable_env": "URG",
      "coverage_merge_executable_default": "urg"
    },
    "questa": {
      "library_executable_env": "VLIB",
      "library_executable_default": "vlib",
      "compile_executable_env": "VLOG",
      "compile_executable_default": "vlog",
      "elaborate_executable_env": "VOPT",
      "elaborate_executable_default": "vopt",
      "run_executable_env": "VSIM",
      "run_executable_default": "vsim",
      "coverage_merge_executable_env": "VCOVER",
      "coverage_merge_executable_default": "vcover",
      "uvm_source_env": "QUESTA_UVM_SRC",
      "uvm_library_env": "QUESTA_UVM_LIB"
    },
    "iverilog": {
      "compile_executable_env": "IVERILOG",
      "compile_executable_default": "iverilog",
      "run_executable_env": "VVP",
      "run_executable_default": "vvp",
      "scope": "rtl_smoke_only"
    }
  }
}
